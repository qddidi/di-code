# Interactive terminals need no configuration: npm run dev starts the provider wizard.
# For print/JSON/CI, uncomment one provider block and use a real local secret.

# DI_CODE_PROVIDER=deepseek
# DI_CODE_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=<your-deepseek-api-key>
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# DI_CODE_PROVIDER=openai
# DI_CODE_MODEL=gpt-4o
# OPENAI_API_KEY=<your-openai-api-key>

# Custom OpenAI-compatible provider example:
# DI_CODE_PROVIDER=custom-openai
# DI_CODE_MODEL=custom-model
# CUSTOM_OPENAI_API_KEY=<your-custom-openai-api-key>
DI_CODE_OPENAI_SMOKE=0
DI_CODE_DEEPSEEK_SMOKE=0
