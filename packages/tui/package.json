{
	"name": "@di-code/tui",
	"version": "0.2.1",
	"description": "Reusable terminal UI library for di-code",
	"keywords": [
		"terminal-ui",
		"tui",
		"ansi",
		"cli",
		"typescript",
		"renderer"
	],
	"private": false,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/qddidi/di-code.git",
		"directory": "packages/tui"
	},
	"bugs": {
		"url": "https://github.com/qddidi/di-code/issues"
	},
	"homepage": "https://github.com/qddidi/di-code#readme",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"get-east-asian-width": "1.6.0",
		"marked": "^18.0.5"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@xterm/headless": "5.5.0"
	}
}
