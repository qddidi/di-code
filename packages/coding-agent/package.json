{
	"name": "@di-code/coding-agent",
	"version": "0.0.0",
	"description": "Coding agent product layer for di-code",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"di-code": "./dist/entry.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "node --experimental-strip-types src/entry.ts",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@di-code/agent": "0.0.0",
		"@di-code/ai": "0.0.0",
		"@di-code/tui": "0.0.0"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
