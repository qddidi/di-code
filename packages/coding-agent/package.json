{
	"name": "@di-code/coding-agent",
	"version": "0.1.7",
	"description": "Coding agent product layer for di-code",
	"keywords": [
		"ai-coding-agent",
		"coding-agent",
		"cli",
		"developer-tools",
		"openai",
		"deepseek",
		"jsonl",
		"rpc"
	],
	"private": false,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"di-code": "./dist/entry.js",
		"di-code-rpc": "./dist/rpc-entry.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./rpc": {
			"types": "./dist/rpc/index.d.ts",
			"import": "./dist/rpc/index.js"
		},
		"./plugin-manager": {
			"types": "./dist/plugin-manager.d.ts",
			"import": "./dist/plugin-manager.js"
		},
		"./plugin-inventory": {
			"types": "./dist/plugin-inventory.d.ts",
			"import": "./dist/plugin-inventory.js"
		},
		"./plugin-trace": {
			"types": "./dist/plugin-trace.d.ts",
			"import": "./dist/plugin-trace.js"
		},
		"./plugin-dump-composition": {
			"types": "./dist/plugin-dump-composition.d.ts",
			"import": "./dist/plugin-dump-composition.js"
		},
		"./mcp-config-entry": {
			"types": "./dist/mcp-config-entry.d.ts",
			"import": "./dist/mcp-config-entry.js"
		},
		"./mcp-client-entry": {
			"types": "./dist/mcp-client-entry.d.ts",
			"import": "./dist/mcp-client-entry.js"
		},
		"./mcp-tools-entry": {
			"types": "./dist/mcp-tools-entry.d.ts",
			"import": "./dist/mcp-tools-entry.js"
		}
	},
	"files": [
		"dist"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/qddidi/di-code.git",
		"directory": "packages/coding-agent"
	},
	"bugs": {
		"url": "https://github.com/qddidi/di-code/issues"
	},
	"homepage": "https://github.com/qddidi/di-code#readme",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "node --experimental-strip-types src/entry.ts",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@di-code/agent": "0.1.7",
		"@di-code/ai": "0.1.7",
		"@di-code/builtins": "0.1.7",
		"@di-code/mcp": "0.1.7",
		"@di-code/plugin-loader": "0.1.7",
		"@di-code/plugin-runtime": "0.1.7",
		"@di-code/skills": "0.1.7",
		"@di-code/tui": "0.1.7",
		"diff": "8.0.4",
		"highlight.js": "^10.7.3",
		"jiti": "^2.5.1"
	},
	"optionalDependencies": {
		"@mariozechner/clipboard": "0.3.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
