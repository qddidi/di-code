{
	"name": "@di-code/coding-agent",
	"version": "0.1.0",
	"description": "Coding agent product layer for di-code",
	"private": false,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"di-code": "./dist/entry.js",
		"di-code-rpc": "./dist/rpc-entry.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./rpc": {
			"types": "./dist/rpc/index.d.ts",
			"import": "./dist/rpc/index.js"
		}
	},
	"files": [
		"dist"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "node --experimental-strip-types src/entry.ts",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@di-code/agent": "0.1.0",
		"@di-code/ai": "0.1.0",
		"@di-code/tui": "0.1.0"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
